{
  "name": "ai-context-merger",
  "displayName": "AI Context Merger - Combine Code to Prompt & Markdown",
  "description": "Combine code files into formatted Markdown for LLMs",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-context-merger-sidebar",
          "title": "AI Context Merger",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-context-merger-sidebar": [
        {
          "type": "webview",
          "id": "aiContextMergerControlsView",
          "name": "Управление и контекст",
          "icon": "resources/icon.svg"
        },
        {
          "id": "aiContextMergerTreeView",
          "name": "Файлы проекта",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "aiContextMerger.addToContext",
        "title": "➕ Добавить в контекст",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.removeFromContext",
        "title": "➖ Убрать из контекста",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.copyImmediately",
        "title": "📋 Скопировать сразу в буфер",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.copyGitDiffImmediately",
        "title": "🌿 Скопировать Git Diff",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.treeToggleSelectedOnly",
        "title": "Показать только выбранные",
        "category": "AI Context Merger",
        "icon": "$(filter)"
      },
      {
        "command": "aiContextMerger.treeShowAll",
        "title": "Показать все файлы",
        "category": "AI Context Merger",
        "icon": "$(filter-filled)"
      },
      {
        "command": "aiContextMerger.treeCopyContext",
        "title": "Скопировать весь контекст",
        "category": "AI Context Merger",
        "icon": "$(copy)"
      },
      {
        "command": "aiContextMerger.treeClearAll",
        "title": "Снять всё выделение",
        "category": "AI Context Merger",
        "icon": "$(clear-all)"
      },
      {
        "command": "aiContextMerger.treeRefresh",
        "title": "Обновить файлы и Git",
        "category": "AI Context Merger",
        "icon": "$(refresh)"
      },
      {
        "command": "aiContextMerger.treeItemCopyFile",
        "title": "Скопировать этот файл",
        "category": "AI Context Merger",
        "icon": "$(copy)"
      },
      {
        "command": "aiContextMerger.treeItemOpenDiff",
        "title": "Показать Git Diff",
        "category": "AI Context Merger",
        "icon": "$(diff)"
      }
    ],
    "submenus": [
      {
        "id": "aiContextMerger.contextSubmenu",
        "label": "AI Context Merger"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "aiContextMerger.contextSubmenu",
          "group": "7_modification@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "aiContextMerger.contextSubmenu",
          "group": "7_modification@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "aiContextMerger.contextSubmenu",
          "group": "7_modification@1"
        }
      ],
      "aiContextMerger.contextSubmenu": [
        {
          "command": "aiContextMerger.addToContext",
          "group": "1_context@1"
        },
        {
          "command": "aiContextMerger.removeFromContext",
          "group": "1_context@2"
        },
        {
          "command": "aiContextMerger.copyImmediately",
          "group": "2_copy@1"
        },
        {
          "command": "aiContextMerger.copyGitDiffImmediately",
          "group": "2_copy@2"
        }
      ],
      "view/title": [
        {
          "command": "aiContextMerger.treeToggleSelectedOnly",
          "when": "view == aiContextMergerTreeView && !aiContextMerger.showOnlySelected",
          "group": "navigation@1"
        },
        {
          "command": "aiContextMerger.treeShowAll",
          "when": "view == aiContextMergerTreeView && aiContextMerger.showOnlySelected",
          "group": "navigation@1"
        },
        {
          "command": "aiContextMerger.treeCopyContext",
          "when": "view == aiContextMergerTreeView",
          "group": "navigation@2"
        },
        {
          "command": "aiContextMerger.treeClearAll",
          "when": "view == aiContextMergerTreeView",
          "group": "navigation@3"
        },
        {
          "command": "aiContextMerger.treeRefresh",
          "when": "view == aiContextMergerTreeView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "aiContextMerger.treeItemOpenDiff",
          "when": "view == aiContextMergerTreeView && viewItem =~ /modified/",
          "group": "inline@1"
        },
        {
          "command": "aiContextMerger.treeItemCopyFile",
          "when": "view == aiContextMergerTreeView && viewItem =~ /file/",
          "group": "inline@2"
        },
        {
          "command": "aiContextMerger.addToContext",
          "when": "view == aiContextMergerTreeView && viewItem =~ /unchecked/",
          "group": "1_toggle@1"
        },
        {
          "command": "aiContextMerger.removeFromContext",
          "when": "view == aiContextMergerTreeView && viewItem =~ /checked/",
          "group": "1_toggle@2"
        },
        {
          "command": "aiContextMerger.treeItemCopyFile",
          "when": "view == aiContextMergerTreeView && viewItem =~ /file/ && !listMultiSelection",
          "group": "2_action@1"
        },
        {
          "command": "aiContextMerger.treeItemOpenDiff",
          "when": "view == aiContextMergerTreeView && viewItem =~ /modified/ && !listMultiSelection",
          "group": "2_action@2"
        },
        {
          "command": "aiContextMerger.copyImmediately",
          "when": "view == aiContextMergerTreeView",
          "group": "3_batch@1"
        },
        {
          "command": "aiContextMerger.copyGitDiffImmediately",
          "when": "view == aiContextMergerTreeView",
          "group": "3_batch@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}