{
  "name": "ai-context-merger",
  "displayName": "AI Context Merger - Combine Code to Prompt & Markdown",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "alex-developer",
  "author": {
    "name": "Alex Developer",
    "url": "https://github.com/ozzy-osbourne"
  },
  "license": "MIT",
  "pricing": "Free",
  "homepage": "https://github.com/ozzy-osbourne/ai-context-merger/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozzy-osbourne/ai-context-merger"
  },
  "bugs": {
    "url": "https://github.com/ozzy-osbourne/ai-context-merger/issues"
  },
  "icon": "resources/icon.png",
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai context",
    "chatgpt",
    "claude",
    "code to markdown",
    "code to prompt",
    "combine files",
    "llm",
    "merge code",
    "prompt",
    "repomix"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "AI Context Merger",
      "properties": {
        "aiContextMerger.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru",
            "zh-cn",
            "es",
            "pt-br",
            "ja",
            "de"
          ],
          "enumDescriptions": [
            "Auto (Follow VS Code language)",
            "English",
            "Русский",
            "简体中文",
            "Español",
            "Português (Brasil)",
            "日本語",
            "Deutsch"
          ],
          "default": "auto",
          "description": "%config.language.description%",
          "scope": "application"
        },
        "aiContextMerger.ignoredDirectoryPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            ".vscode",
            ".idea",
            "node_modules",
            "dist",
            "out",
            "build",
            ".next",
            ".nuxt",
            ".svelte-kit",
            ".astro",
            ".turbo",
            ".parcel-cache",
            ".docusaurus",
            ".vite",
            ".swc",
            ".terraform",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache",
            ".ruff_cache",
            ".tox",
            ".venv",
            "venv",
            "env",
            "target",
            "vendor",
            ".gradle",
            ".dart_tool",
            "Library",
            "Temp",
            "Obj",
            "Build",
            "Builds",
            "Logs",
            "UserSettings",
            "MemoryCaptures",
            "coverage",
            ".nyc_output",
            ".cache",
            ".DS_Store",
            "Thumbs.db",
            "desktop.ini"
          ],
          "description": "%config.ignoredDirectoryPatterns.description%",
          "scope": "resource"
        },
        "aiContextMerger.lockFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            "Cargo.lock",
            "composer.lock",
            "poetry.lock",
            "Pipfile.lock",
            "bun.lockb",
            "bun.lock",
            "Gemfile.lock",
            "uv.lock",
            "pdm.lock",
            "go.sum",
            "pubspec.lock",
            "Podfile.lock",
            "packages.lock.json",
            "flake.lock"
          ],
          "description": "%config.lockFilePatterns.description%",
          "scope": "resource"
        },
        "aiContextMerger.binaryExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".rpyc", ".rpym", ".rpymc", ".rpyb", ".rpa", ".save", ".pyc", ".pyo", ".pyd", ".class",
            ".exe", ".dll", ".so", ".dylib", ".wasm", ".o", ".obj", ".bin", ".hex",
            ".png", ".jpg", ".jpeg", ".gif", ".ico", ".webp", ".svg", ".bmp", ".tiff", ".psd", ".ai",
            ".mp3", ".wav", ".ogg", ".flac", ".aac", ".mp4", ".avi", ".webm", ".mkv", ".mov", ".wmv",
            ".zip", ".tar", ".gz", ".tgz", ".rar", ".7z", ".bz2", ".xz", ".jar", ".war", ".apk", ".ipa",
            ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
            ".ttf", ".otf", ".woff", ".woff2", ".eot",
            ".sqlite", ".sqlite3", ".db", ".dat", ".cache"
          ],
          "description": "%config.binaryExtensions.description%",
          "scope": "resource"
        },
        "aiContextMerger.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "%config.maxFileSizeMB.description%",
          "scope": "window"
        },
        "aiContextMerger.maxDiffSizeKB": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 5000,
          "description": "%config.maxDiffSizeKB.description%",
          "scope": "window"
        },
        "aiContextMerger.defaultOutputFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "xml"
          ],
          "default": "markdown",
          "description": "%config.defaultOutputFormat.description%",
          "scope": "window"
        },
        "aiContextMerger.defaultTokenLimit": {
          "type": "string",
          "enum": [
            "32000",
            "64000",
            "128000",
            "200000",
            "1000000",
            "2000000"
          ],
          "default": "200000",
          "description": "%config.defaultTokenLimit.description%",
          "scope": "window"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-context-merger-sidebar",
          "title": "%viewsContainers.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-context-merger-sidebar": [
        {
          "type": "webview",
          "id": "aiContextMergerControlsView",
          "name": "%views.controls.name%",
          "icon": "resources/icon.svg"
        },
        {
          "id": "aiContextMergerTreeView",
          "name": "%views.tree.name%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "aiContextMerger.addToContext",
        "title": "%command.addToContext%",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.removeFromContext",
        "title": "%command.removeFromContext%",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.copyImmediately",
        "title": "%command.copyImmediately%",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.copyGitDiffImmediately",
        "title": "%command.copyGitDiffImmediately%",
        "category": "AI Context Merger"
      },
      {
        "command": "aiContextMerger.treeToggleSelectedOnly",
        "title": "%command.treeToggleSelectedOnly%",
        "category": "AI Context Merger",
        "icon": "$(filter)"
      },
      {
        "command": "aiContextMerger.treeShowAll",
        "title": "%command.treeShowAll%",
        "category": "AI Context Merger",
        "icon": "$(filter-filled)"
      },
      {
        "command": "aiContextMerger.treeCopyContext",
        "title": "%command.treeCopyContext%",
        "category": "AI Context Merger",
        "icon": "$(copy)"
      },
      {
        "command": "aiContextMerger.treeClearAll",
        "title": "%command.treeClearAll%",
        "category": "AI Context Merger",
        "icon": "$(clear-all)"
      },
      {
        "command": "aiContextMerger.treeRefresh",
        "title": "%command.treeRefresh%",
        "category": "AI Context Merger",
        "icon": "$(refresh)"
      },
      {
        "command": "aiContextMerger.treeItemCopyFile",
        "title": "%command.treeItemCopyFile%",
        "category": "AI Context Merger",
        "icon": "$(copy)"
      },
      {
        "command": "aiContextMerger.treeItemOpenDiff",
        "title": "%command.treeItemOpenDiff%",
        "category": "AI Context Merger",
        "icon": "$(diff)"
      }
    ],
    "submenus": [
      {
        "id": "aiContextMerger.contextSubmenu",
        "label": "AI Context Merger"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "aiContextMerger.contextSubmenu",
          "group": "7_modification@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "aiContextMerger.contextSubmenu",
          "group": "7_modification@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "aiContextMerger.contextSubmenu",
          "group": "7_modification@1"
        }
      ],
      "aiContextMerger.contextSubmenu": [
        {
          "command": "aiContextMerger.addToContext",
          "group": "1_context@1"
        },
        {
          "command": "aiContextMerger.removeFromContext",
          "group": "1_context@2"
        },
        {
          "command": "aiContextMerger.copyImmediately",
          "group": "2_copy@1"
        },
        {
          "command": "aiContextMerger.copyGitDiffImmediately",
          "group": "2_copy@2"
        }
      ],
      "view/title": [
        {
          "command": "aiContextMerger.treeToggleSelectedOnly",
          "when": "view == aiContextMergerTreeView && !aiContextMerger.showOnlySelected",
          "group": "navigation@1"
        },
        {
          "command": "aiContextMerger.treeShowAll",
          "when": "view == aiContextMergerTreeView && aiContextMerger.showOnlySelected",
          "group": "navigation@1"
        },
        {
          "command": "aiContextMerger.treeCopyContext",
          "when": "view == aiContextMergerTreeView",
          "group": "navigation@2"
        },
        {
          "command": "aiContextMerger.treeClearAll",
          "when": "view == aiContextMergerTreeView",
          "group": "navigation@3"
        },
        {
          "command": "aiContextMerger.treeRefresh",
          "when": "view == aiContextMergerTreeView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "aiContextMerger.treeItemOpenDiff",
          "when": "view == aiContextMergerTreeView && viewItem =~ /modified/",
          "group": "inline@1"
        },
        {
          "command": "aiContextMerger.treeItemCopyFile",
          "when": "view == aiContextMergerTreeView && viewItem =~ /file/",
          "group": "inline@2"
        },
        {
          "command": "aiContextMerger.addToContext",
          "when": "view == aiContextMergerTreeView && viewItem =~ /unchecked/",
          "group": "1_toggle@1"
        },
        {
          "command": "aiContextMerger.removeFromContext",
          "when": "view == aiContextMergerTreeView && viewItem =~ /checked/",
          "group": "1_toggle@2"
        },
        {
          "command": "aiContextMerger.treeItemCopyFile",
          "when": "view == aiContextMergerTreeView && viewItem =~ /file/ && !listMultiSelection",
          "group": "2_action@1"
        },
        {
          "command": "aiContextMerger.treeItemOpenDiff",
          "when": "view == aiContextMergerTreeView && viewItem =~ /modified/ && !listMultiSelection",
          "group": "2_action@2"
        },
        {
          "command": "aiContextMerger.copyImmediately",
          "when": "view == aiContextMergerTreeView",
          "group": "3_batch@1"
        },
        {
          "command": "aiContextMerger.copyGitDiffImmediately",
          "when": "view == aiContextMergerTreeView",
          "group": "3_batch@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}